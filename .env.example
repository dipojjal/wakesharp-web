# Copy to .env.local for `vercel dev`, or run `vercel env pull`.
# In production these live in Vercel → Settings → Environment Variables.

# Resend API key used by api/contact.ts to deliver the /contact form.
# Server-side only — do NOT rename this to PUBLIC_*, which is the prefix Astro
# exposes to the browser bundle.
RESEND_API_KEY=

# Growth APIs are fail-closed. Keep both toggles false until Gate C and Gate G.
REFERRALS_API_ENABLED=false
REFERRAL_REWARDS_ENABLED=false

# Neon connection string; server-side only. Apply db/migrations explicitly.
DATABASE_URL=
REFERRAL_CREDENTIAL_PEPPER=
REFERRAL_OPERATIONS_SECRET=

# Private service that performs stateful App Attest / Play Integrity validation.
# The public API contains no development or "trust the client" bypass.
ATTESTATION_VERIFIER_URL=
ATTESTATION_VERIFIER_SECRET=
WAKESHARP_IOS_APP_ID=W4HPRW2JT4.com.wakesharp.app
WAKESHARP_ANDROID_PACKAGE=com.wakesharp.app

# RevenueCat API v2 secret and resource IDs; never expose these as PUBLIC_*.
REVENUECAT_V2_SECRET_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_PLUS_ENTITLEMENT_ID=

# Aggregate Apple AdAttributionKit postbacks. Production stays disabled until
# the copy endpoint, app identifier, migration, and disclosure pass Gate G.
APPLE_ATTRIBUTION_ENABLED=false
APPLE_ADVERTISED_ITEM_IDENTIFIER=
ALLOW_APPLE_DEVELOPMENT_POSTBACKS=false
