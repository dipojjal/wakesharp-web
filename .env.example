# Copy to .env.local for `vercel dev`, or run `vercel env pull`.
# In production these live in Vercel → Settings → Environment Variables.

# Resend API key used by api/contact.ts to deliver the /contact form.
# Server-side only - do NOT rename this to PUBLIC_*, which is the prefix Astro
# exposes to the browser bundle.
RESEND_API_KEY=

# The referral API is fail-closed: every endpoint answers 503 `referrals_disabled`
# until this is exactly "true". Keep it false until Gate C.
REFERRALS_API_ENABLED=false

# 2.16 programme switches, read by GET /api/referrals/config (no database).
# Platforms the programme is on for (default ios,android); "false" lifts the
# Squats lock on every client; "true" accepts sandbox purchases (QA only).
REFERRALS_PLATFORMS=ios,android
REFERRALS_SQUATS_LOCK=true
REFERRALS_ACCEPT_SANDBOX=false

# Supabase transaction pooler (port 6543) as the referrals_api role; server-side
# only. The schema is the app repo's supabase/migrations/*_growth_referrals.sql.
DATABASE_URL=
# Optional extra root certificates (PEM). Supabase's current root is bundled in
# api/_lib/supabase-root-ca.ts; set this only for a successor root.
DATABASE_CA_CERT=
# 32+ random bytes. Never rotate after launch: it keys install credentials,
# rate-limit buckets and the purchase-reference HMAC.
REFERRAL_CREDENTIAL_PEPPER=
REFERRAL_OPERATIONS_SECRET=
# Authenticates the daily retention cron (/api/internal/referrals/prune).
CRON_SECRET=
# Local only: a Supabase branch or local stack with the app's migrations applied
# enables tests/growth/conversion-sql.test.ts. Never the production database.
GROWTH_TEST_DATABASE_URL=

# Private service performing stateful App Attest / Play Integrity validation.
# The public API contains no development or "trust the client" bypass, so
# registration returns 503 `attestation_not_configured` until this exists.
ATTESTATION_VERIFIER_URL=
ATTESTATION_VERIFIER_SECRET=
WAKESHARP_IOS_APP_ID=W4HPRW2JT4.com.wakesharp.app
WAKESHARP_ANDROID_PACKAGE=com.wakesharp.app

# Public PostHog ingestion key for WakeSharp project 559689 (not a personal API token).
PUBLIC_POSTHOG_KEY=
# Set this key in Vercel Production before building, and confirm project 559689.
# Preview/local web events are environment=qa and excluded from the dashboard.
