    {
      "name": "Website subscription revenue: RC event date",
      "description": "USD amounts from RC initial purchases, conversions, renewals and cancellations (including negative refund adjustments). Gross before fees/taxes, not install-cohort LTV. Delivery/deduplication validation pending.",
      "query": {
        "kind": "TrendsQuery",
        "dateRange": {
          "date_from": "-30d"
        },
        "interval": "day",
        "filterTestAccounts": true,
        "properties": [
          {
            "key": "af_media_source",
            "type": "person",
            "operator": "exact",
            "value": "wakesharp_website"
          },
          {
            "key": "af_campaign",
            "type": "person",
            "operator": "exact",
            "value": "WakeSharp Website"
          }
        ],
        "series": [
          {
            "kind": "EventsNode",
            "event": "rc_initial_purchase_event",
            "math": "sum",
            "math_property": "revenue"
          },
          {
            "kind": "EventsNode",
            "event": "rc_trial_converted_event",
            "math": "sum",
            "math_property": "revenue"
          },
          {
            "kind": "EventsNode",
            "event": "rc_renewal_event",
            "math": "sum",
            "math_property": "revenue"
          },
          {
            "kind": "EventsNode",
            "event": "rc_cancellation_event",
            "math": "sum",
            "math_property": "revenue"
          }
        ]
      }
    },
    {
      "name": "App attribution coverage including unknown",
      "description": "All observed app opens broken down by event-time acquisition source. Empty/unknown stays visible. Not website engagement and not store-download counts.",
      "query": {
        "kind": "TrendsQuery",
        "dateRange": {
          "date_from": "-30d"
        },
        "interval": "day",
        "filterTestAccounts": true,
        "series": [
          {
            "kind": "EventsNode",
            "event": "Application Opened",
            "math": "dau"
          }
        ],
        "breakdownFilter": {
          "breakdowns": [
            {
              "property": "af_media_source",
              "type": "person"
            }
          ]
        }
      }
    }
  ]
}
