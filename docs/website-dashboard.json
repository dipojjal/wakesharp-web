{
  "projectId": 559689,
  "dashboardId": 2137569,
  "insights": [
    {
      "name": "Website tools: views, starts and completions",
      "description": "Consented production website events by tool. Counts actions, not users. Inputs/results are excluded. Prospective until website deployment.",
      "query": {
        "kind": "TrendsQuery",
        "dateRange": {
          "date_from": "-30d"
        },
        "interval": "day",
        "filterTestAccounts": true,
        "properties": [
          {
            "key": "surface",
            "type": "event",
            "operator": "exact",
            "value": "website"
          },
          {
            "key": "environment",
            "type": "event",
            "operator": "exact",
            "value": "production"
          }
        ],
        "series": [
          {
            "kind": "EventsNode",
            "event": "website_tool_viewed",
            "math": "total"
          },
          {
            "kind": "EventsNode",
            "event": "website_tool_started",
            "math": "total"
          },
          {
            "kind": "EventsNode",
            "event": "website_tool_completed",
            "math": "total"
          }
        ],
        "breakdownFilter": {
          "breakdowns": [
            {
              "property": "tool",
              "type": "event"
            }
          ]
        }
      }
    },
    {
      "name": "Website download clicks by page and placement",
      "description": "Consented production website download clicks; these are not installs. Website identity remains separate from app identity.",
      "query": {
        "kind": "TrendsQuery",
        "dateRange": {
          "date_from": "-30d"
        },
        "interval": "day",
        "filterTestAccounts": true,
        "properties": [
          {
            "key": "surface",
            "type": "event",
            "operator": "exact",
            "value": "website"
          },
          {
            "key": "environment",
            "type": "event",
            "operator": "exact",
            "value": "production"
          }
        ],
        "series": [
          {
            "kind": "EventsNode",
            "event": "website_download_clicked",
            "math": "total"
          }
        ],
        "breakdownFilter": {
          "breakdowns": [
            {
              "property": "page",
              "type": "event"
            },
            {
              "property": "placement",
              "type": "event"
            }
          ]
        }
      }
    },
    {
      "name": "Website desktop QR views",
      "description": "Consented QR page views, not scans or installs. Production traffic only.",
      "query": {
        "kind": "TrendsQuery",
        "dateRange": {
          "date_from": "-30d"
        },
        "interval": "day",
        "filterTestAccounts": true,
        "properties": [
          {
            "key": "surface",
            "type": "event",
            "operator": "exact",
            "value": "website"
          },
          {
            "key": "environment",
            "type": "event",
            "operator": "exact",
            "value": "production"
          }
        ],
        "series": [
          {
            "kind": "EventsNode",
            "event": "website_qr_viewed",
            "math": "total"
          }
        ]
      }
    },
    {
      "name": "Website attributed app users: first observed app open",
      "description": "First matching Application Opened for website-attributed users. Delayed attribution may miss an earlier open; AppsFlyer is the install authority. Event-date view, no website identity join.",
      "query": {
        "kind": "TrendsQuery",
        "dateRange": {
          "date_from": "-30d"
        },
        "interval": "day",
        "filterTestAccounts": true,
        "properties": [
          {
            "key": "af_media_source",
            "type": "person",
            "operator": "exact",
            "value": "wakesharp_website"
          },
          {
            "key": "af_campaign",
            "type": "person",
            "operator": "exact",
            "value": "WakeSharp Website"
          }
        ],
        "series": [
          {
            "kind": "EventsNode",
            "event": "Application Opened",
            "math": "first_matching_event_for_user"
          }
        ]
      }
    },
    {
