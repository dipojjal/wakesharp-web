---
/**
 * End-of-article download card. Rendered by BlogPostLayout after the markdown
 * body, so plain .md posts get a store CTA without MDX or hand-typed store
 * links (scripts/check-copy.mjs only permits the canonical URLs, which
 * StoreButtons reads from src/config/site.ts).
 *
 * Styles are self-contained on purpose: the sitewide `.callout` class is
 * scoped `.legal .callout` inside LegalLayout and does not exist here.
 */
import StoreButtons from './StoreButtons.astro';
import { getCatalog } from '../i18n/catalog';
import type { EnabledLocale } from '../i18n/config';

interface Props {
  locale: EnabledLocale;
  heading?: string;
  body?: string;
}
const { locale } = Astro.props;
const t = getCatalog(locale.code).blog.cta;
const { heading = t.heading, body = t.body } = Astro.props;
---

<aside class="cta-card" aria-label={t.aria}>
  <h2>{heading}</h2>
  <p>{body}</p>
  <StoreButtons tone="light" />
</aside>

<style>
  .cta-card {
    margin-top: 3rem;
    border-radius: var(--radius-card);
    background: var(--color-morning-surface);
    border: 1px solid color-mix(in srgb, var(--color-morning-text) 12%, transparent);
    box-shadow: var(--shadow-card);
    padding: 1.75rem;
  }
  .cta-card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.4rem;
  }
  .cta-card p {
    margin: 0 0 1.25rem;
    color: var(--tone-dim);
    line-height: 1.6;
  }
</style>
