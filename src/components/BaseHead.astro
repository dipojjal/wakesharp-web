---
import { SITE, isLive } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Path only, e.g. "/privacy". Canonical is built from SITE.url. */
  path: string;
  noindex?: boolean;
  /** Blog posts pass 'article'; everything else keeps the default. */
  ogType?: 'website' | 'article';
  /** Root-relative or absolute social-card URL. Defaults to the sitewide /og.png. */
  image?: string;
  imageAlt?: string;
  /** ISO 8601 datetimes, rendered only when ogType is 'article'. */
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description = SITE.description,
  path,
  noindex = false,
  ogType = 'website',
  image,
  imageAlt = 'WakeSharp — wake up sharp, not just awake.',
  publishedTime,
  modifiedTime,
} = Astro.props;
const canonical = new URL(path, SITE.url).href.replace(/\/$/, '') || SITE.url;
const ogImage = image ? new URL(image, SITE.url).href : new URL('/og.png', SITE.url).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta name="theme-color" content="#121229" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="WakeSharp Blog" href="/rss.xml" />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{ogType === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{ogType === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{/* Smart App Banner. Safari shows an install/open strip on iPhone; the id is
    the bare App Store id, not a URL, so it cannot reuse SITE.stores.ios.url. */}
{isLive(SITE.stores.ios) && <meta name="apple-itunes-app" content={`app-id=${SITE.appStoreId}`} />}
