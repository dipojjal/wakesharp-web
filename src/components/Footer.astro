---
import { SITE, TRADEMARKS } from '../config/site';
import LanguageList from './LanguageList.astro';
import { getCatalog } from '../i18n/catalog';
import { interpolate } from '../i18n/rich';
import { localePath, type Alternate } from '../i18n/routes';
import type { EnabledLocale } from '../i18n/config';

interface Props {
  locale: EnabledLocale;
  switchTo: Alternate[];
  fallbackPath: string;
  /** The Blog link target: the locale's own index when it has posts, else /blog. */
  blogHref: string;
}
const { locale, switchTo, fallbackPath, blogHref } = Astro.props;
const t = getCatalog(locale.code).shell;
const href = (p: string): string => localePath(locale, p);
const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-night-deep)] text-[var(--color-night-text)] px-6 pt-16 pb-10">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2.5">
          <img src="/icon-192.png" alt="" width="32" height="32" class="rounded-lg" />
          <span class="text-xl font-extrabold tracking-[-0.02em]">WakeSharp</span>
        </div>
        <p class="mt-3 text-sm text-[var(--color-night-dim)]">{t.tagline}</p>
      </div>

      <nav aria-label={t.footer.product}>
        <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-night-dim)]">{t.footer.product}</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="hover:text-[var(--color-amber)]" href={href('/#features')}>{t.footer.features}</a></li>
          <li><a class="hover:text-[var(--color-amber)]" href={href('/#sharp')}>{t.footer.sharpnessScore}</a></li>
          <li><a class="hover:text-[var(--color-amber)]" href={href('/#pricing')}>{t.footer.pricing}</a></li>
          <li><a class="hover:text-[var(--color-amber)]" href={blogHref}>{t.footer.blog}</a></li>
          <li><a class="hover:text-[var(--color-amber)]" href={href('/#faq')}>{t.footer.faq}</a></li>
        </ul>
      </nav>

      <nav aria-label={t.footer.legal}>
        <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-night-dim)]">{t.footer.legal}</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="hover:text-[var(--color-amber)]" href={href('/privacy')}>{t.footer.privacy}</a></li>
          <li><a class="hover:text-[var(--color-amber)]" href={href('/terms')}>{t.footer.terms}</a></li>
          <li><a class="hover:text-[var(--color-amber)]" href={href('/support')}>{t.footer.support}</a></li>
          {/* Filed with Google Play as the account-deletion URL, and until now
              nothing on the site linked to it. */}
          <li><a class="hover:text-[var(--color-amber)]" href={href('/account/delete')}>{t.footer.deleteAccount}</a></li>
        </ul>
      </nav>

      <div>
        <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-night-dim)]">{t.footer.contact}</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="hover:text-[var(--color-amber)]" href={href('/contact')}>{t.footer.contactForm}</a></li>
          <li><a class="hover:text-[var(--color-amber)] break-all" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        </ul>
        <p class="mt-4 text-sm text-[var(--color-night-dim)]">
          {interpolate(t.footer.builtBy, { publisher: SITE.publisher })}
        </p>
      </div>
    </div>

    <LanguageList locale={locale} switchTo={switchTo} fallbackPath={fallbackPath} />

    <!--
      The safety notice lives here, on every page, not only inside Terms section 8.
      The homepage makes strong reliability claims; the same reader has to see the
      qualification. An alarm that fails to wake someone is a real liability surface.
    -->
    <p class="mt-12 rounded-[var(--radius-card)] border border-white/10 bg-white/[0.04] p-4 text-sm leading-relaxed text-[var(--color-night-dim)]">
      <strong class="text-[var(--color-night-text)]">{t.footer.pleaseNote}</strong> {t.footer.safetyNotice}{' '}
      <a class="underline decoration-dotted underline-offset-2 hover:text-[var(--color-amber)]" href={href('/terms#safety')}>{t.footer.fullSafetyNotice}</a>.
    </p>

    <div class="mt-8 border-t border-white/10 pt-6 text-xs leading-relaxed text-[var(--color-night-dim)]">
      {TRADEMARKS.map((line) => <p>{line}</p>)}
      <p class="mt-3">{interpolate(t.footer.rights, { year, publisher: SITE.publisher })}</p>
    </div>
  </div>
</footer>
