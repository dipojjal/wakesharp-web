---
import { Picture, getImage } from 'astro:assets';
import { storeAssets, artworkLocale } from '../lib/store-assets';
import { refreshCopy } from '../lib/refresh';
import type { EnabledLocaleCode } from '../i18n/config';
interface Props { localeCode: EnabledLocaleCode; platform?: 'iphone' | 'watch' }
const { localeCode, platform = 'iphone' } = Astro.props;
const t = refreshCopy(localeCode);
const captions = platform === 'watch' ? t.watchCaptions : t.captions;
const shots = await Promise.all(storeAssets(localeCode, platform).map(async (asset, i) => ({
  ...asset, caption: captions[i]!, enlarged: await getImage({ src: asset.image, width: platform === 'watch' ? 422 : 1000, format: 'webp', quality: 88 }),
})));
---
<div class="store-gallery" data-gallery>
  {(platform === 'watch' ? localeCode !== 'en' : artworkLocale(localeCode) !== localeCode) && <p class="mb-5 text-sm dim">{t.englishArtwork}</p>}
  <ul class="store-rail" aria-label={platform === 'watch' ? 'Apple Watch' : 'iPhone'}>
    {shots.map((shot) => <li>
      <figure>
        <a href={shot.enlarged.src} data-enlarge aria-label={`${t.open}: ${shot.caption}`}>
          <Picture src={shot.image} alt={`${platform === 'watch' ? 'Apple Watch' : 'iPhone'}: ${shot.caption}`} widths={platform === 'watch' ? [211,422] : [220,440,660]} sizes="(max-width: 480px) 64vw, 260px" formats={['avif','webp']} fallbackFormat="webp" quality={76} loading="lazy" decoding="async" />
        </a>
        <figcaption><span class="dim">{String(shot.order).padStart(2,'0')}.</span> {shot.caption}</figcaption>
      </figure>
    </li>)}
  </ul>
  <dialog aria-label={t.open}>
    <button type="button" data-close>{t.close} <span aria-hidden="true">×</span></button>
    <img src={shots[0]!.enlarged.src} width={shots[0]!.enlarged.attributes.width} height={shots[0]!.enlarged.attributes.height} alt="" loading="lazy" />
    <p data-caption></p>
  </dialog>
</div>
<script>
for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
  const dialog = gallery.querySelector<HTMLDialogElement>('dialog')!;
  const enlarged = dialog.querySelector('img')!;
  const close = dialog.querySelector<HTMLButtonElement>('[data-close]')!;
  let trigger: HTMLAnchorElement | null = null;
  const links = [...gallery.querySelectorAll<HTMLAnchorElement>('[data-enlarge]')];
  links.forEach((link,index) => {
    link.addEventListener('click',event => {
      if (!dialog.showModal || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault(); trigger = link;
      const source = link.querySelector('img')!;
      enlarged.src = link.href; enlarged.alt = source.alt;
      enlarged.width = source.naturalWidth; enlarged.height = source.naturalHeight;
      dialog.querySelector('[data-caption]')!.textContent = link.closest('figure')!.querySelector('figcaption')!.textContent;
      dialog.showModal(); close.focus();
    });
    link.addEventListener('keydown',event => {
      const rtl = document.documentElement.dir === 'rtl';
      const delta = event.key === 'ArrowRight' ? (rtl ? -1 : 1) : event.key === 'ArrowLeft' ? (rtl ? 1 : -1) : 0;
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? links.length - 1 : delta ? (index + delta + links.length) % links.length : -1;
      if (next >= 0) { event.preventDefault(); links[next]!.focus(); }
    });
  });
  close.addEventListener('click',() => dialog.close());
  dialog.addEventListener('click',event => { if (event.target === dialog) dialog.close(); });
  dialog.addEventListener('close',() => trigger?.focus());
}
</script>
<style>
.store-rail{display:flex;gap:1.5rem;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:thin;padding:1rem .25rem 1.5rem}.store-rail li{flex:0 0 min(64vw,260px);scroll-snap-align:start}.store-rail :global(img){width:100%;height:auto;border-radius:1rem;box-shadow:0 8px 20px #0003}.store-rail a{display:block;border-radius:1rem}.store-rail a:focus-visible{outline:3px solid currentColor;outline-offset:5px}figcaption{font-size:.9rem;line-height:1.5;margin-top:1rem}dialog{border:0;border-radius:1rem;background:#fff7eb;color:#332921;padding:1.25rem;max-width:min(95vw,700px);max-height:95dvh;overflow:auto}dialog::backdrop{background:#10111feb}dialog img{display:block;max-height:75dvh;width:auto;max-width:100%;object-fit:contain;margin:1rem auto}dialog button{display:block;margin-inline-start:auto;padding:.75rem 1rem;border:1px solid;border-radius:2rem;cursor:pointer;font-weight:700}dialog p{text-align:center}dialog:not([open]){display:none}@media(prefers-reduced-motion:no-preference){.store-rail{scroll-behavior:smooth}}
</style>
