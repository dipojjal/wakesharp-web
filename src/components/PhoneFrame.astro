---
/**
 * Site-drawn device frame around a clean app capture.
 *
 * The geometry mirrors tools/screenshots/frames.py in the app repo so the phones
 * here and the phones in the store screenshots are recognisably the same object:
 * rail gradient #8A8D93 -> #2A2C30, inner bezel #08080A, screen radius ~0.141 of
 * body width. Using the raw captures rather than the shipped store frames lets the
 * site write its own headlines instead of shipping images with headlines baked in.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Rendered CSS width in px at the largest breakpoint. */
  width?: number;
  tilt?: number;
  priority?: boolean;
  class?: string;
}
const { src, alt, width = 300, tilt = 0, priority = false, class: cls = '' } = Astro.props;
---

<div
  class:list={['phone-frame', cls]}
  style={`--w:${width}px;${tilt ? `--tilt:${tilt}deg;` : ''}`}
>
  <div class="phone-frame__rail">
    <div class="phone-frame__screen">
      <Picture
        src={src}
        alt={alt}
        widths={[width, width * 2, width * 3]}
        sizes={`(max-width: 640px) 70vw, ${width}px`}
        formats={['avif', 'webp']}
        fallbackFormat="png"
        quality={72}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    </div>
  </div>
</div>

<style>
  .phone-frame {
    width: min(var(--w), 70vw);
    max-width: 100%;
    rotate: var(--tilt, 0deg);
    filter: drop-shadow(0 24px 40px rgb(0 0 0 / 0.42));
  }
  .phone-frame__rail {
    /* Rail width is ~1.1% of body width in the app's compositor. */
    padding: max(2px, 1.1cqw);
    padding: 0.011em;
    padding: clamp(2px, 1.1%, 5px);
    border-radius: 15.5%/7.2%;
    background: linear-gradient(to bottom, #8a8d93, #2a2c30);
  }
  .phone-frame__screen {
    /* Bezel: 2.3% of body width, solid #08080A under the rail. */
    padding: 2.3%;
    border-radius: 14.5%/6.7%;
    background: #08080a;
    overflow: hidden;
  }
  .phone-frame__screen :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 11%/5%;
  }
</style>
