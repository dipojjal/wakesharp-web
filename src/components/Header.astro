---
/**
 * Always-translucent sticky nav.
 *
 * A `position: sticky` element cannot switch background on scroll in CSS alone —
 * that needs either `animation-timeline: scroll()` (not Baseline) or an
 * IntersectionObserver. Holding one translucent night bar the whole way down keeps
 * the page at zero JS and reads correctly over both the dark and the light bands.
 *
 * There is no mobile drawer, so below `md` the nav collapses to Blog and Contact:
 * the section links all point at homepage anchors a phone visitor can reach
 * by scrolling, while /blog and /contact are real pages they otherwise could not
 * get to at all. The language menu sits beside the CTA and shrinks to a bare
 * globe below `sm` for the same reason.
 */
import LanguageMenu from './LanguageMenu.astro';
import { getCatalog } from '../i18n/catalog';
import { localePath, type Alternate } from '../i18n/routes';
import type { EnabledLocale } from '../i18n/config';

interface Props {
  locale: EnabledLocale;
  switchTo: Alternate[];
  fallbackPath: string;
  /** The Blog link target: the locale's own index when it has posts, else /blog. */
  blogHref: string;
}
const { locale, switchTo, fallbackPath, blogHref } = Astro.props;
const t = getCatalog(locale.code).shell;
const href = (p: string): string => localePath(locale, p);
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-[color-mix(in_srgb,var(--color-night-surface)_82%,transparent)] backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:gap-4 sm:px-6">
    <a href={href('/')} class="flex items-center gap-2.5 text-[var(--color-night-text)]">
      <img src="/icon-192.png" alt="" width="28" height="28" class="rounded-[8px]" />
      {/* Below `sm` the wordmark would collide with the always-visible Blog and
          Contact links, so the app icon carries the brand alone there. */}
      <span class="hidden text-lg font-extrabold tracking-[-0.02em] sm:inline" aria-hidden="true">WakeSharp</span>
      <span class="sr-only">{t.brandHome}</span>
    </a>

    {/* nowrap: a nav label of two words wraps inside its flex item and makes the
        whole header taller — Arabic "تواصل معنا", French "Fonctions". Inherited
        by the links, so it is one rule rather than five. */}
    <nav
      aria-label={t.nav.aria}
      class="flex items-center gap-4 whitespace-nowrap text-sm font-semibold text-[var(--color-night-dim)] sm:gap-5 md:gap-7"
    >
      <a class="hidden hover:text-[var(--color-night-text)] md:inline" href={href('/#features')}>{t.nav.features}</a>
      <a class="hidden hover:text-[var(--color-night-text)] md:inline" href={href('/#pricing')}>{t.nav.pricing}</a>
      <a class="hover:text-[var(--color-night-text)]" href={blogHref}>{t.nav.blog}</a>
      <a class="hover:text-[var(--color-night-text)]" href={href('/contact')}>{t.nav.contact}</a>
      <a class="hidden hover:text-[var(--color-night-text)] md:inline" href={href('/#faq')}>{t.nav.faq}</a>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <LanguageMenu locale={locale} switchTo={switchTo} fallbackPath={fallbackPath} />
      {/* whitespace-nowrap: a two-word CTA wraps inside the pill in the longer
          languages (German "WakeSharp laden") and doubles the header height. */}
      <a
        href={href('/#get')}
        class="pill whitespace-nowrap bg-[var(--color-coral)] px-4 py-2 text-sm text-[var(--color-night-deep)]"
      >{t.nav.cta}</a>
    </div>
  </div>
</header>
