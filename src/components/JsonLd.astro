---
import { SITE, isLive } from '../config/site';
import { getCatalog } from '../i18n/catalog';
import { localePath, resolveLocale } from '../i18n/routes';
import type { EnabledLocale } from '../i18n/config';

/**
 * MobileApplication, not SoftwareApplication — it is the narrower type. Both
 * store URLs are present now that the apps are live; `offers` describes the real
 * pricing: WakeSharp Unlimited, yearly with a free trial or monthly without one.
 * There is no free tier and no Lifetime offer (claims-matrix.md), so neither
 * appears here.
 *
 * Still no `aggregateRating`. The ratings live on the stores (one on the App
 * Store as of 2026-09-24), and Google's review-snippet rules forbid marking up
 * ratings copied from another site; inventing one would be false as well as a
 * structured-data penalty. Add it only from reviews collected on this site.
 *
 * `inLanguage`, `url` and `description` follow the page's locale; the Offer
 * descriptions are the paywall's own English bullets and stay that way.
 */
interface Props {
  locale?: EnabledLocale;
}
const { locale = resolveLocale(Astro.currentLocale) } = Astro.props;
const shell = getCatalog(locale.code).shell;

const live = [
  isLive(SITE.stores.ios) ? SITE.stores.ios.url : null,
  isLive(SITE.stores.android) ? SITE.stores.android.url : null,
].filter(Boolean);

/** What Unlimited is, in the App Store description's own words. */
const UNLIMITED = 'Every wake-up mission, warm-up rotation, Lark scene, alarm wallpaper, smart alarm, profile, rotation and your full Sharpness history. No ads.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: SITE.name,
  // The two listings carry different names as of 2026-09-24. An array is the
  // only honest single value here. Re-read both listings before editing:
  // itunes.apple.com/lookup?id=6801198703&country=us and the Play listing.
  alternateName: ['Loud Alarm Clock - WakeSharp', 'WakeSharp: Loud Alarm Clock'],
  description: shell.siteDescription,
  url: new URL(localePath(locale, '/'), SITE.url).href.replace(/\/$/, ''),
  inLanguage: locale.hreflang,
  image: new URL('/og.png', SITE.url).href,
  applicationCategory: 'ProductivityApplication',
  applicationSubCategory: 'Alarm Clock',
  operatingSystem: `${SITE.requirements.ios}, ${SITE.requirements.android}`,
  ...(live.length ? { downloadUrl: live, installUrl: live } : {}),
  author: { '@type': 'Organization', name: SITE.publisher },
  publisher: { '@type': 'Organization', name: SITE.publisher },
  offers: [
    {
      '@type': 'Offer',
      name: 'WakeSharp Unlimited (yearly)',
      price: SITE.unlimited.annual.replace('$', ''),
      priceCurrency: 'USD',
      description: `${UNLIMITED} A ${SITE.unlimited.trialDays}-day free trial for eligible new subscribers, then ${SITE.unlimited.annual} per year. Renews until cancelled.`,
    },
    {
      '@type': 'Offer',
      name: 'WakeSharp Unlimited (monthly)',
      price: SITE.unlimited.monthly.replace('$', ''),
      priceCurrency: 'USD',
      description: `${UNLIMITED} ${SITE.unlimited.monthly} per month, with no trial. Renews until cancelled.`,
    },
  ],
  privacyPolicy: new URL('/privacy', SITE.url).href,
  termsOfService: new URL('/terms', SITE.url).href,
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
