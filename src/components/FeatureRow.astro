---
import type { ImageMetadata } from 'astro';
import PhoneFrame from './PhoneFrame.astro';

interface Props {
  screenshot: ImageMetadata;
  alt: string;
  side?: 'left' | 'right';
  /** Wrap the copy AND the heading in the scrim card (the `sharp` band needs this). */
  scrim?: boolean;
  /** Lift the phone onto an elevated card so a dark screen separates from a dark band. */
  raised?: boolean;
  tilt?: number;
}
const { screenshot, alt, side = 'left', scrim = false, raised = false, tilt = 0 } = Astro.props;
---

<div
  class:list={[
    'grid items-center gap-10 lg:gap-16',
    'lg:grid-cols-2',
  ]}
>
  <div class:list={['flex justify-center', side === 'right' && 'lg:order-2']}>
    {
      raised ? (
        <div class="rounded-[28px] border border-white/10 bg-[var(--color-night-elevated)] p-5">
          <PhoneFrame src={screenshot} alt={alt} width={300} tilt={tilt} />
        </div>
      ) : (
        <PhoneFrame src={screenshot} alt={alt} width={300} tilt={tilt} />
      )
    }
  </div>

  <div class:list={[side === 'right' && 'lg:order-1']}>
    {scrim ? <div class="scrim"><slot /></div> : <slot />}
  </div>
</div>
