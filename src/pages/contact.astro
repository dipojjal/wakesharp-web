---
import LegalLayout from '../layouts/LegalLayout.astro';
import { SITE } from '../config/site';
---

<LegalLayout
  title="Contact — WakeSharp"
  description="Message the developer of WakeSharp directly — bug reports, alarm problems, subscription questions and feature requests."
  path="/contact"
  heading="Contact"
  intro="WakeSharp is made by one person, and that person reads everything that arrives here."
  showUpdated={false}
>
  <div class="callout">
    <p class="!mb-0">
      I usually reply within <strong>2–3 business days</strong>. If you would rather use your own mail
      client, write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a> — it reaches the same inbox.
    </p>
  </div>

  <!--
    Zero JS by design: a plain POST to the Vercel function at /api/contact, which
    answers with a 303 to a static result page. No fetch, no JSON, no success-state
    script. The action must have no trailing slash — vercel.json sets
    trailingSlash:false, so /api/contact/ would cost a 308 hop before the POST lands.
  -->
  <form method="POST" action="/api/contact" class="mt-8 grid gap-5">
    <div>
      <label class="field-label" for="name">Your name</label>
      <input class="field" id="name" name="name" type="text" required maxlength="80" autocomplete="name" />
    </div>

    <div>
      <label class="field-label" for="email">Your email</label>
      <input class="field" id="email" name="email" type="email" required maxlength="160" autocomplete="email" />
      <p class="mt-1.5 text-sm dim">So I can reply. It is used for nothing else.</p>
    </div>

    <div>
      <label class="field-label" for="topic">What is this about?</label>
      <select class="field" id="topic" name="topic" required>
        <option value="" disabled selected>Choose one…</option>
        <option>An alarm didn't ring</option>
        <option>Bug report</option>
        <option>Subscription or billing</option>
        <option>Feature request</option>
        <option>Something else</option>
      </select>
    </div>

    <div>
      <label class="field-label" for="device">
        Phone and OS version <span class="field-hint">— optional, but it answers half my follow-up questions</span>
      </label>
      <input
        class="field"
        id="device"
        name="device"
        type="text"
        maxlength="120"
        placeholder="e.g. Pixel 9, Android 16"
      />
    </div>

    <div>
      <label class="field-label" for="message">Message</label>
      <textarea class="field" id="message" name="message" required maxlength="4000" rows="9"></textarea>
      <p class="mt-1.5 text-sm dim">
        For a bug, what you expected and what happened instead is the most useful thing you can tell me.
        If an alarm failed, the time it was set for and the time you found the phone helps a great deal.
      </p>
    </div>

    <!--
      Honeypot. Off-screen rather than display:none, and tabindex=-1 so it stays out
      of the tab order (which is also what keeps aria-hidden legitimate here).
    -->
    <div class="honeypot" aria-hidden="true">
      <label for="company">Company</label>
      <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="mt-2">
      <button
        type="submit"
        class="pill bg-[var(--color-coral-ink)] px-6 py-3 text-[var(--color-morning-cream)]"
      >Send message</button>
    </div>

    <p class="text-sm dim">
      Your message and email address are sent to me by email and are not stored anywhere else. See the{' '}
      <a href="/privacy#contact-form">Privacy Policy</a>.
    </p>
  </form>
</LegalLayout>
