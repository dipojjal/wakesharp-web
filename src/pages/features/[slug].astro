---
import FeaturePage from '../../templates/FeaturePage.astro';
import { getFeaturePages } from '../../lib/features';
export async function getStaticPaths() { return (await getFeaturePages('en')).map(page => ({params:{slug:page.data.translationOf},props:{page}})); }
const { page } = Astro.props;
---
<FeaturePage page={page}/>
