---
import BaseLayout from '../layouts/BaseLayout.astro';
import SunriseSection from '../components/SunriseSection.astro';
import FeatureRow from '../components/FeatureRow.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import StoreButtons from '../components/StoreButtons.astro';
import StoreGallery from '../components/StoreGallery.astro';
import Lark from '../components/Lark.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../config/site';

import iosHome from '../assets/screens/ios/home.png';
import iosRing from '../assets/screens/ios/ring.png';
import iosSmart from '../assets/screens/ios/smart.png';
import iosMission from '../assets/screens/ios/mission.png';
import iosGames from '../assets/screens/ios/games.png';
import iosReveal from '../assets/screens/ios/reveal.png';
import androidStats from '../assets/screens/android/stats.png';

const trust = [
  'Platform-native alarm delivery, when permitted',
  'Tells you what could stop it — before the morning',
  'No account, ever',
  'Your calendar never leaves your device',
  'Every alarm free, forever',
];

// Mirrors the gates the shipped paywall actually enforces. If these lists and
// PaywallView/PaywallScreen ever disagree, the app is right and this is wrong.
const freeFeatures = [
  'As many alarms as you need',
  'Every mission type — math, scan, walk and barcode',
  'All 13 alarm tones',
  'Strict Mode, and the reliability check',
  'One smart calendar alarm',
  'One shift rotation, one alarm profile',
  'Streaks and freeze tokens',
  'A warm-up game after every mission',
  'Your 7-day Sharpness trend',
];

const plusFeatures = [
  'Everything in Free',
  'Three warm-up games every morning, rotating through all five across the week',
  'Scan missions on every alarm, not just one',
  'Unlimited smart calendar alarms',
  'Your full Sharpness history, however far back it goes',
  'Lark scenes, alarm wallpapers and celebrations',
];

const faqs = [
  {
    q: 'Does it really ring in Silent, Focus or Do Not Disturb?',
    a: 'Behavior is platform-specific. On supported iPhone versions, WakeSharp uses Apple’s AlarmKit, including supported Silent and Focus behavior when alarm permission is granted. On Android it uses an exact alarm, the alarm audio stream, and a full-screen alarm notification when the required permissions and manufacturer settings allow them; Do Not Disturb behavior can depend on notification-policy access. No app can ring on a phone that is switched off, out of battery, or prevented by the operating system — so use a second device for anything you truly cannot miss.',
  },
  {
    q: 'How do I check whether my alarm is configured and ready?',
    a: 'Open Settings → Alarm reliability. WakeSharp reads known conditions that can stop an alarm — permissions, alarm volume, notification settings, lock-screen takeover, and battery restrictions — and reports whether the current configuration looks ready, needs attention, or cannot ring. It does not turn unknown conditions into a guarantee. If an alarm fails, the app reports a cause only when it can prove one.',
  },
  {
    q: 'Do I have to do maths at 6am?',
    a: 'Only if you want to. A mission can be a math sprint, scanning an object across the room, scanning a barcode, or getting up and walking — or “Surprise me”, which picks one for you each day. Every mission has a way out that ends in a math sprint at full credit, so a dead camera or a phone on the nightstand never traps you.',
  },
  {
    q: 'Can I cheat past the mission?',
    a: 'You can dismiss the alarm without a mission — the phone’s system Stop or dismiss control remains available. WakeSharp then shows an owed-mission screen next time you open it, so your streak can still be repaired. You can also snooze twice, at a cost of 5 Sharpness each. Optional Strict Mode can re-ring up to three times where the platform permits it.',
  },
  {
    q: 'What does the camera do?',
    a: 'Only the scan mission uses it, and only while that mission is running. Frames are classified on your device — Apple’s Vision framework on iPhone, a small bundled model on Android — to check whether you are looking at the thing you chose. Nothing is uploaded, nothing is saved, and no frame outlives the mission. Decline the permission and every other mission still works.',
  },
  {
    q: 'What exactly does it read from my calendar?',
    a: 'Your upcoming events, read-only, entirely on your device, for one purpose: working out what time to wake you. Nothing is transmitted anywhere. It is optional, and every other feature works if you decline it.',
  },
  {
    q: 'Do I need an account?',
    a: 'No. There isn’t one to make. No email, no password, no sign-in.',
  },
  {
    q: 'What is free and what is Plus?',
    a: 'Every alarm and every mission is free forever, along with all 13 alarm tones, Strict Mode, the reliability check, streaks, a warm-up game after each mission, one smart calendar alarm and your 7-day trend. Plus adds three rotating warm-up games each morning, scan missions on every alarm, unlimited smart alarms, your full Sharpness history, and the Lark scenes and wallpapers. Nothing that wakes you up is ever behind it.',
  },
  {
    q: 'Is Lifetime a subscription?',
    a: 'No. Lifetime is a single payment for the same WakeSharp Plus features — it does not renew, and there is nothing to cancel. Monthly and annual do renew until you stop them. The 7-day free trial belongs to the annual plan.',
  },
  {
    q: 'How do I cancel?',
    a: 'Through the App Store or Google Play, any time. Deleting the app does not cancel a subscription. Lifetime has nothing to cancel — it is a one-time purchase, and Restore Purchases brings it back on a new phone.',
  },
  {
    q: 'Does it track me?',
    a: 'No advertising ID, no location, no account to profile, and no tracking across other apps. What leaves your device: anonymous usage analytics (a random ID and which screens you use — never your alarms, calendar or camera), plus subscription data if you buy Plus. The privacy policy lists every byte.',
  },
];
---

<BaseLayout title="WakeSharp — Wake up sharp. Not just awake." path="/">
  <JsonLd />

  {/* ── 1. Hero ─────────────────────────────────────────────────────────── */}
  <SunriseSection id="hero" class="!pt-16 sm:!pt-20">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <div class="mb-6 lg:hidden">
          <Lark pose="asleep" width={150} breathe glow priority />
        </div>
        <h1 class="text-[clamp(2.5rem,8vw,4.25rem)] leading-[1.05]">
          Wake up <span class="accent">sharp.</span><br />Not just awake.
        </h1>
        <p class="lede mt-6">
          A mission-based alarm with platform-native ring handling and a readiness check. Complete your
          mission to earn full morning credit; system Stop and dismiss controls remain available.
        </p>
        <div class="mt-8"><StoreButtons /></div>
      </div>

      <div class="relative flex justify-center lg:block">
        <div class="pointer-events-none absolute -top-4 -left-10 z-10 hidden lg:block">
          <Lark pose="asleep" width={165} breathe glow priority />
        </div>
        <PhoneFrame src={iosHome} alt="WakeSharp home screen at night, showing a 6:40 AM alarm and a smart calendar rule" width={300} tilt={-3.5} priority class="lg:ml-auto lg:mr-2 lg:mt-28" />
      </div>
    </div>
  </SunriseSection>

  {/* ── 2. Trust strip ──────────────────────────────────────────────────── */}
  <SunriseSection id="trust" class="!py-10" anchor="features">
    <ul class="flex flex-wrap justify-center gap-3">
      {
        trust.map((t) => (
          <li class="rounded-full border border-white/12 bg-white/[0.06] px-4 py-2 text-sm font-semibold">
            {t}
          </li>
        ))
      }
    </ul>
  </SunriseSection>

  {/* ── 3. Ring ─────────────────────────────────────────────────────────── */}
  <SunriseSection id="ring">
    <FeatureRow screenshot={iosRing} alt="The WakeSharp alarm ringing, with Start Mission and Snooze" side="left">
      <h2 class="text-[clamp(1.9rem,5vw,3rem)]">Complete the mission for <span class="accent">full credit</span></h2>
      <p class="lede mt-5">
        On supported iPhone versions, Apple’s AlarmKit presents the system alarm over the lock screen when
        alarm access is authorized. On Android, WakeSharp uses an exact alarm, the alarm stream, and a
        full-screen notification when permissions and manufacturer settings allow them. The system Stop or
        dismiss control always remains; completing the mission is what earns full morning credit.
      </p>
    </FeatureRow>
  </SunriseSection>

  {/* ── 4. Reliability ──────────────────────────────────────────────────── */}
  <SunriseSection id="reliable">
    <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_auto]">
      <div class="max-w-2xl">
        <h2 class="text-[clamp(1.9rem,5vw,3rem)]">Check whether it’s ready, <span class="accent">the night before</span></h2>
        <p class="lede mt-5">
          Most alarm apps find out they failed at the same moment you do. WakeSharp checks the things that
          actually stop alarms — permissions, alarm volume, notification settings, lock-screen takeover,
          battery restrictions — and leads with a verdict, not a promise.
        </p>
        <ul class="mt-7 grid gap-3 sm:grid-cols-2">
          <li class="rounded-xl border border-white/12 bg-white/[0.06] p-4">
            <strong class="block">A verdict, not a checklist</strong>
            <span class="dim text-[0.95rem]">One line at the top: looks ready, needs attention, or cannot ring.</span>
          </li>
          <li class="rounded-xl border border-white/12 bg-white/[0.06] p-4">
            <strong class="block">Honest about what it can’t see</strong>
            <span class="dim text-[0.95rem]">Where the phone won’t tell us, it says so — never a green tick.</span>
          </li>
          <li class="rounded-xl border border-white/12 bg-white/[0.06] p-4">
            <strong class="block">One-tap fixes where they exist</strong>
            <span class="dim text-[0.95rem]">And plain instructions where they don’t.</span>
          </li>
          <li class="rounded-xl border border-white/12 bg-white/[0.06] p-4">
            <strong class="block">“It didn’t ring” gets an answer</strong>
            <span class="dim text-[0.95rem]">The provable cause — or an admission that we couldn’t tell.</span>
          </li>
        </ul>
        <p class="dim mt-6 text-sm">
          It is free, it is in Settings, and the pre-bed reminder folds the worst finding in so you see it
          while there is still time to fix it.
        </p>
      </div>

      <div class="hidden justify-self-center lg:block">
        <Lark pose="focused" width={230} />
      </div>
    </div>
  </SunriseSection>

  {/* ── 5. Smart alarms ─────────────────────────────────────────────────── */}
  <SunriseSection id="smart">
    <FeatureRow screenshot={iosSmart} alt="The smart alarm rule editor, set to ring 90 minutes before the first meeting" side="right" raised>
      <h2 class="text-[clamp(1.9rem,5vw,3rem)]">Wakes you before your <span class="accent">first meeting</span></h2>
      <p class="lede mt-5">
        “Ring 90 minutes before my first meeting.” WakeSharp reads your calendar on-device and can adjust the
        wake time after it receives a refresh opportunity and sees that the event moved. Read-only, optional,
        and never transmitted.
      </p>
    </FeatureRow>
  </SunriseSection>

  {/* ── 6. Mission ──────────────────────────────────────────────────────── */}
  <SunriseSection id="mission">
    <FeatureRow screenshot={iosMission} alt="The math mission: solve 6 minus 3 to silence the alarm" side="left">
      <h2 class="text-[clamp(1.9rem,5vw,3rem)]">Four ways to <span class="accent">complete your mission</span></h2>
      <p class="lede mt-5">
        Solve a math sprint. Scan something across the room. Scan a barcode in the kitchen. Or get up and walk
        — it counts steps, and shaking the phone doesn’t fool it. Pick one per alarm, or let “Surprise me”
        choose. Optional Strict Mode can re-ring up to three times where supported; snoozing costs 5
        Sharpness a time, twice.
      </p>
    </FeatureRow>
  </SunriseSection>

  {/* ── 7. Warm-up ──────────────────────────────────────────────────────── */}
  <SunriseSection id="games">
    <FeatureRow screenshot={iosGames} alt="The Memory Match warm-up game" side="right">
      <h2 class="text-[clamp(1.9rem,5vw,3rem)]">5 <span class="accent">brain games.</span> 3 every morning.</h2>
      <p class="lede mt-5">
        Math Sprint, Memory Match, Sequence Recall, Word Dash and Reaction Tap — a short warm-up while the
        kettle boils. Free gives you a game after every mission; Plus runs three each morning and rotates
        them, so the whole set comes round inside a week — and never repeats whatever the mission just made you do.
      </p>
    </FeatureRow>
  </SunriseSection>

  {/* ── 8. Sharpness — scrim mandatory, see src/config/sunrise.ts ───────── */}
  <SunriseSection id="sharp" class="min-h-[100svh] flex items-center">
    <FeatureRow screenshot={iosReveal} alt="The daily Sharpness Score reveal" side="left" scrim>
      <h2 class="text-[clamp(1.9rem,5vw,3rem)]">Know how <span class="accent">sharp</span> you woke up</h2>
      <p class="lede mt-5">
        One number out of 100, scored against your own rolling baseline — not against strangers. Yesterday’s
        you is the only benchmark that means anything at 6am.
      </p>
    </FeatureRow>
  </SunriseSection>

  {/* ── 9. Streaks & trends ─────────────────────────────────────────────── */}
  <SunriseSection id="stats">
    <FeatureRow screenshot={androidStats} alt="The Sharpness trend chart with a streak counter" side="right">
      <h2 class="text-[clamp(1.9rem,5vw,3rem)]">Watch yourself get <span class="accent">sharper</span></h2>
      <p class="lede mt-5">
        A streak, a trend line, and a freeze token for the days life happens. Seven days of history free —
        with Plus, everything you have ever logged, however far back that goes.
      </p>
    </FeatureRow>
  </SunriseSection>

  {/* ── 10. Both platforms ──────────────────────────────────────────────── */}
  <SunriseSection id="platforms">
    <div class="max-w-2xl">
      <h2 class="text-[clamp(1.9rem,5vw,3rem)]">Same app. <span class="accent">Both phones.</span></h2>
      <p class="lede mt-5">
        Built natively twice — SwiftUI on iOS, Kotlin and Compose on Android. Not a wrapper. Requires
        {' '}{SITE.requirements.ios} or {SITE.requirements.android}.
      </p>
      <p class="mt-4 dim">
        There’s a watch app on both wrists, too — watchOS 26 or Wear OS 3. It taps you awake before the room
        hears anything, and the phone alarm is shifted a few minutes later as the backup. Only a dismissal
        from the watch cancels it.
      </p>
    </div>
    <StoreGallery />
  </SunriseSection>

  {/* ── 11. Pricing ─────────────────────────────────────────────────────── */}
  <SunriseSection id="pricing">
    <div class="max-w-2xl">
      <h2 class="text-[clamp(1.9rem,5vw,3rem)]">Every alarm is <span class="accent">free forever</span></h2>
      <p class="lede mt-5">
        So is every mission, and all 13 tones. Plus is for the morning after the alarm — more warm-up games,
        more smart rules, and the whole history. Nothing that wakes you up is ever behind it.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="card p-7">
        <h3 class="text-xl">Free</h3>
        <p class="mt-1 text-4xl font-extrabold">$0</p>
        <p class="mt-1 text-sm dim">No account, no trial to forget about.</p>
        <ul class="mt-6 space-y-2.5 text-[0.97rem]">
          {freeFeatures.map((f) => <li class="flex gap-2.5"><span aria-hidden="true" class="text-[var(--color-success)] font-bold">✓</span><span>{f}</span></li>)}
        </ul>
      </div>

      <div class="card relative p-7 ring-2 ring-[var(--color-coral)]">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="text-xl">WakeSharp Plus</h3>
            <p class="mt-1 text-4xl font-extrabold">
              {SITE.plus.monthly}<span class="text-base font-semibold dim">/month</span>
            </p>
          </div>
          <div class="hidden sm:block"><Lark pose="celebrating" width={100} /></div>
        </div>

        {/* Three ways to pay, one entitlement — not three tiers. Lifetime is a
            single payment and must never be shown as a renewing plan. */}
        <ul class="mt-4 space-y-1.5 text-sm dim">
          <li>or <strong class="font-semibold">{SITE.plus.annual}/year</strong>, with a {SITE.plus.trialDays}-day free trial</li>
          <li>or <strong class="font-semibold">{SITE.plus.lifetime} once</strong> — Lifetime, which never renews</li>
        </ul>

        <ul class="mt-6 space-y-2.5 text-[0.97rem]">
          {plusFeatures.map((f) => <li class="flex gap-2.5"><span aria-hidden="true" class="text-[var(--color-coral-ink)] font-bold">✓</span><span>{f}</span></li>)}
        </ul>
      </div>
    </div>

    <p class="mt-6 max-w-2xl text-sm dim">
      Monthly and annual are billed by Apple or Google and renew until cancelled — cancel any time in your
      store account, and note that deleting the app does not cancel a subscription. Lifetime is a single
      payment with nothing to cancel. See the <a class="underline underline-offset-2" href="/terms">Terms</a>.
    </p>
  </SunriseSection>

  {/* ── 12. FAQ ─────────────────────────────────────────────────────────── */}
  <SunriseSection id="faq">
    <h2 class="text-[clamp(1.9rem,5vw,3rem)]">Questions, <span class="accent">answered</span></h2>
    <div class="mt-8 max-w-3xl divide-y divide-black/10">
      {
        faqs.map((f) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold">
              {f.q}
              <span aria-hidden="true" class="shrink-0 text-2xl leading-none transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 leading-relaxed dim">{f.a}</p>
          </details>
        ))
      }
    </div>
  </SunriseSection>

  {/* ── 13. Final CTA ───────────────────────────────────────────────────── */}
  <SunriseSection id="cta" anchor="get">
    <div class="flex flex-col items-center text-center">
      <Lark pose="encouraging" width={170} />
      <h2 class="mt-6 text-[clamp(1.9rem,5vw,3rem)]">Tomorrow morning starts <span class="accent">tonight</span></h2>
      <p class="lede mx-auto mt-5 text-center">
        Set one alarm. See what a sharp morning actually feels like.
      </p>
      <div class="mt-8"><StoreButtons tone="light" align="center" /></div>
    </div>
  </SunriseSection>
</BaseLayout>

<style>
  details summary::-webkit-details-marker { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .group-open\:rotate-45 { transition: none; }
  }
</style>
