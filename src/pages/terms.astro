---
/**
 * https://wakesharp.app/terms is hardcoded in both shipped apps' paywalls and
 * must keep answering 200 in English with no redirect. The body lives in
 * src/templates/TermsBody.astro so the localized wrappers can reuse it.
 */
import LegalLayout from '../layouts/LegalLayout.astro';
import TermsBody from '../templates/TermsBody.astro';
import { TERMS } from '../templates/legal-copy';
import { alternatesFor, resolveLocale } from '../i18n/routes';
---

<LegalLayout
  title={TERMS.title}
  description={TERMS.description}
  path="/terms"
  heading={TERMS.heading}
  intro={TERMS.intro}
  locale={resolveLocale('en')}
  alternates={[]}
  switchTo={alternatesFor('/terms')}
>
  <TermsBody />
</LegalLayout>
