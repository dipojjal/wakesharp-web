---
/**
 * https://wakesharp.app/privacy is hardcoded in both shipped apps' paywalls and
 * must keep answering 200 in English with no redirect. The body lives in
 * src/templates/PrivacyBody.astro so the localized wrappers can reuse it.
 */
import LegalLayout from '../layouts/LegalLayout.astro';
import PrivacyBody from '../templates/PrivacyBody.astro';
import { PRIVACY } from '../templates/legal-copy';
import { alternatesFor, resolveLocale } from '../i18n/routes';
---

<LegalLayout
  title={PRIVACY.title}
  description={PRIVACY.description}
  path="/privacy"
  heading={PRIVACY.heading}
  intro={PRIVACY.intro}
  locale={resolveLocale('en')}
  alternates={[]}
  switchTo={alternatesFor('/privacy')}
>
  <PrivacyBody />
</LegalLayout>
