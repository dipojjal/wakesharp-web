---
/**
 * /blog/<slug> — one page per published post. Paths come exclusively from
 * getPublishedPosts(): a draft or future-dated post is never generated, which
 * also keeps it out of the sitemap automatically.
 */
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getPublishedPosts, getRelatedPosts, readingTime } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: getRelatedPosts(post, posts, 3) },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}
const { post, related } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body ?? '');
---

<BlogPostLayout post={post} related={related} minutes={minutes}>
  <Content />
</BlogPostLayout>
