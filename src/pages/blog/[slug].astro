---
/**
 * /blog/<slug> — one page per published English post. Paths come exclusively
 * from getPublishedPosts(): a draft or future-dated post is never generated,
 * which also keeps it out of the sitemap automatically. Translations are
 * served by src/pages/[lang]/blog/[slug].astro.
 */
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getPublishedPosts, getRelatedPosts, readingMinutes, slugOf } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts('en');
  return posts.map((post) => ({
    params: { slug: slugOf(post) },
    props: { post, related: getRelatedPosts(post, posts, 3) },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}
const { post, related } = Astro.props;
const { Content } = await render(post);
---

<BlogPostLayout post={post} related={related} minutes={readingMinutes(post.body ?? '')}>
  <Content />
</BlogPostLayout>
