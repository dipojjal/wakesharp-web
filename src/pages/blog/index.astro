---
/**
 * /blog — the English article index. Newest post gets the wide featured card;
 * the rest flow into a three-up grid. Deliberately a single list, not
 * pagination: a paginated /blog/[...page] route would share the /blog/:x route
 * shape with [slug].astro and a purely numeric slug would collide. If the
 * archive ever outgrows one page (~150+ posts), add /blog/page/[page].astro
 * and reserve the literal slug "page" — documented in docs/blog-schedule.md.
 *
 * The same page for every other language with posts is src/pages/[lang]/blog/index.astro.
 */
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCatalog } from '../../i18n/catalog';
import { resolveLocale } from '../../i18n/routes';
import { blogIndexAlternates, getPublishedPosts } from '../../lib/blog';

const locale = resolveLocale('en');
const t = getCatalog(locale.code).blog;
const posts = await getPublishedPosts(locale.code);
const [featured, ...rest] = posts;
const alternates = await blogIndexAlternates();
---

<BlogLayout
  title={t.index.title}
  description={t.index.description}
  path="/blog"
  heading={t.index.heading}
  intro={t.index.intro}
  locale={locale}
  alternates={alternates}
  switchTo={alternates}
>
  {
    featured ? (
      <div class="space-y-8">
        <BlogCard post={featured} featured />
        {rest.length > 0 && (
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {rest.map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        )}
      </div>
    ) : (
      <p class="lede">{t.index.empty}</p>
    )
  }
</BlogLayout>
