---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description?: string;
  path: string;
  heading: string;
  intro?: string;
}
const { title, description, path, heading, intro } = Astro.props;

// Parse at local noon: `new Date('2026-08-14')` is UTC midnight, which renders as
// the previous day for anyone west of UTC.
const updated = new Date(`${SITE.lastUpdated}T12:00:00`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={title} description={description} path={path}>
  <!--
    Legal pages are a flat morning surface, deliberately outside the sunrise ramp.
    These URLs are hardcoded in both shipped apps' paywalls; they need to be
    maximally readable, not atmospheric.
  -->
  <div data-tone="morning" class="bg-[var(--color-morning-cream)] px-6 py-14 text-[var(--color-morning-text)] sm:py-20">
    <div class="mx-auto w-full max-w-[68ch]">
      <h1 class="text-4xl sm:text-5xl">{heading}</h1>
      <p class="mt-3 text-sm dim">Last updated {updated}</p>
      {intro && <p class="mt-6 text-lg leading-relaxed">{intro}</p>}

      <div class="legal mt-10"><slot /></div>

      <hr class="my-12 border-[color-mix(in_srgb,var(--color-morning-text)_15%,transparent)]" />
      <p class="text-sm dim">
        Questions about this page? Email
        <a class="font-semibold text-[var(--color-coral-ink)] underline underline-offset-2" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .legal h2 {
    font-size: 1.4rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .legal h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .legal p,
  .legal li {
    line-height: 1.7;
  }
  .legal p { margin-block: 0.9rem; }
  .legal ul { list-style: disc; padding-left: 1.4rem; margin-block: 0.9rem; }
  .legal ol { list-style: decimal; padding-left: 1.4rem; margin-block: 0.9rem; }
  .legal li { margin-block: 0.4rem; }
  .legal a {
    color: var(--color-coral-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal strong { font-weight: 700; }
  .legal table {
    width: 100%;
    margin-block: 1.25rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .legal th,
  .legal td {
    border: 1px solid color-mix(in srgb, var(--color-morning-text) 15%, transparent);
    padding: 0.6rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .legal th { background: color-mix(in srgb, var(--color-morning-text) 5%, transparent); font-weight: 700; }
  .legal .callout {
    border-radius: var(--radius-card);
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-morning-text) 12%, transparent);
    padding: 1.25rem 1.5rem;
    margin-block: 1.5rem;
  }
  .legal .callout--warn {
    border-color: color-mix(in srgb, var(--color-danger) 45%, transparent);
    background: color-mix(in srgb, var(--color-danger) 6%, #fff);
  }
</style>
