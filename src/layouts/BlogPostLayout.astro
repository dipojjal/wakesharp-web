---
/**
 * Shell for a single blog post: 68ch reading column on the flat morning
 * surface (same reasoning as LegalLayout — readable, not atmospheric), with
 * the article's own OG card, BlogPosting JSON-LD, an end-of-article store CTA
 * and same-category related links.
 *
 * The chrome reads the post's language from its frontmatter, so one layout
 * serves every locale; hreflang pairs a post with its other language versions.
 */
import BaseLayout from './BaseLayout.astro';
import { Picture, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { SITE } from '../config/site';
import BlogCTA from '../components/BlogCTA.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import BlogPostJsonLd from '../components/BlogPostJsonLd.astro';
import { getCatalog } from '../i18n/catalog';
import { formatDate } from '../i18n/dates';
import { interpolate } from '../i18n/rich';
import { localePath, resolveLocale } from '../i18n/routes';
import { postAlternates, postPath, postSwitchTargets } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
  minutes: number;
}
const { post, related, minutes } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroImageAlt, category, tags } =
  post.data;
const locale = resolveLocale(post.data.lang);
const t = getCatalog(locale.code).blog;
const path = postPath(post);
const alternates = await postAlternates(post);
const switchTo = await postSwitchTargets(post);

// One 1200×630 JPG derivative reused for og:image and the JSON-LD image — JPG
// specifically because OG crawlers (notably Facebook's) handle AVIF/WebP
// unreliably. Real visitors get the modern formats via <Picture> below.
const ogImage = await getImage({
  src: heroImage,
  width: 1200,
  height: 630,
  format: 'jpg',
  fit: 'cover',
});
const ogImageUrl = new URL(ogImage.src, SITE.url).href;
const fallback = heroImage.format === 'png' ? 'png' : 'jpg';
---

<BaseLayout
  title={`${title}${t.titleSuffix}`}
  description={description}
  path={path}
  locale={locale}
  alternates={alternates}
  switchTo={switchTo}
  ogType="article"
  image={ogImage.src}
  imageAlt={heroImageAlt}
  publishedTime={pubDate.toISOString()}
  modifiedTime={(updatedDate ?? pubDate).toISOString()}
>
  <BlogPostJsonLd post={post} imageUrl={ogImageUrl} path={path} />

  <article
    data-tone="morning"
    class="bg-[var(--color-morning-cream)] px-6 py-14 text-[var(--color-morning-text)] sm:py-20"
  >
    <div class="mx-auto w-full max-w-[68ch]">
      <a
        href={localePath(locale, '/blog')}
        class="text-sm font-semibold text-[var(--color-coral-ink)] underline underline-offset-2"
        >{t.allArticles}</a
      >
      <p class="mt-6 text-xs font-bold uppercase tracking-wider text-[var(--color-coral-ink)]">
        {t.categories[category]}
      </p>
      <h1 class="mt-2 text-4xl sm:text-5xl">{title}</h1>
      <p class="mt-4 text-sm dim">
        {formatDate(pubDate, locale)} &middot; {interpolate(t.minRead, { minutes })}{
          updatedDate && <> &middot; {interpolate(t.updated, { date: formatDate(updatedDate, locale) })}</>
        }
      </p>

      <Picture
        src={heroImage}
        alt={heroImageAlt}
        widths={[400, 800, 1200]}
        sizes="(min-width: 48rem) 42rem, 92vw"
        formats={['avif', 'webp']}
        fallbackFormat={fallback}
        class="mt-8 aspect-video w-full rounded-[var(--radius-card)] object-cover shadow-[var(--shadow-card)]"
        loading="eager"
        decoding="async"
      />

      <div class="prose mt-10"><slot /></div>

      <BlogCTA locale={locale} />

      {
        tags.length > 0 && (
          <ul class="mt-10 flex flex-wrap gap-2" aria-label={t.tagsAria}>
            {tags.map((tag) => (
              <li class="rounded-full bg-[var(--color-morning-surface)] px-3 py-1 text-xs font-semibold shadow-[var(--shadow-card)]">
                {tag}
              </li>
            ))}
          </ul>
        )
      }

      <RelatedPosts posts={related} locale={locale} />
    </div>
  </article>
</BaseLayout>

<style is:global>
  /* Forked from LegalLayout's .legal block — same reading rhythm, plus the
     img/blockquote/code/table rules a long-form article body needs. Global
     because the markdown body arrives via <slot /> from another file.
     Logical properties throughout, so the Arabic pages mirror for free. */
  .prose h2 {
    font-size: 1.4rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .prose h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .prose p,
  .prose li {
    line-height: 1.7;
  }
  .prose p { margin-block: 0.9rem; }
  .prose ul { list-style: disc; padding-inline-start: 1.4rem; margin-block: 0.9rem; }
  .prose ol { list-style: decimal; padding-inline-start: 1.4rem; margin-block: 0.9rem; }
  .prose li { margin-block: 0.4rem; }
  .prose a {
    color: var(--color-coral-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose strong { font-weight: 700; }
  .prose em { font-style: italic; }
  .prose img {
    border-radius: var(--radius-card);
    margin-block: 1.5rem;
    box-shadow: var(--shadow-card);
  }
  .prose blockquote {
    border-inline-start: 4px solid var(--color-coral);
    padding-inline-start: 1.25rem;
    margin-block: 1.5rem;
    font-style: italic;
    color: var(--tone-dim);
  }
  .prose code {
    background: color-mix(in srgb, var(--color-morning-text) 8%, transparent);
    border-radius: 4px;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
  }
  .prose pre {
    background: var(--color-night-deep);
    color: var(--color-night-text);
    border-radius: var(--radius-card);
    padding: 1.25rem;
    overflow-x: auto;
    margin-block: 1.5rem;
  }
  .prose pre code {
    background: none;
    padding: 0;
  }
  .prose hr {
    border: none;
    border-top: 1px solid color-mix(in srgb, var(--color-morning-text) 15%, transparent);
    margin-block: 2rem;
  }
  .prose table {
    width: 100%;
    margin-block: 1.25rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .prose th,
  .prose td {
    border: 1px solid color-mix(in srgb, var(--color-morning-text) 15%, transparent);
    padding: 0.6rem 0.75rem;
    text-align: start;
    vertical-align: top;
  }
  .prose th {
    background: color-mix(in srgb, var(--color-morning-text) 5%, transparent);
    font-weight: 700;
  }
</style>
