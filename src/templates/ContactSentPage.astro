---
/** /contact-sent: the 303 destination after a successful send. noindex, no hreflang. */
import LegalLayout from '../layouts/LegalLayout.astro';
import Rich from '../i18n/Rich.astro';
import { SITE } from '../config/site';
import { getCatalog } from '../i18n/catalog';
import { alternatesFor, localePath } from '../i18n/routes';
import type { EnabledLocale } from '../i18n/config';

interface Props {
  locale: EnabledLocale;
}
const { locale } = Astro.props;
const t = getCatalog(locale.code).contact.sent;
const vars = { email: SITE.email };
const links = { email: `mailto:${SITE.email}`, support: localePath(locale, '/support') };
---

<LegalLayout
  title={t.title}
  description={t.description}
  path={localePath(locale, '/contact-sent')}
  heading={t.heading}
  intro={t.intro}
  showUpdated={false}
  noindex={true}
  locale={locale}
  alternates={[]}
  switchTo={alternatesFor('/contact-sent')}
>
  <p><Rich text={t.body} vars={vars} links={links} /></p>
  <p><Rich text={t.meanwhile} vars={vars} links={links} /></p>
  <p><a href={localePath(locale, '/')}>{t.backHome}</a></p>
</LegalLayout>
