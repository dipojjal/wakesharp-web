---
/**
 * /account/delete — the account-deletion resource Google Play's Data safety
 * form links to. Deletion itself is in-app (and complete); this page documents
 * it and offers the email fallback for people who no longer have the app.
 */
import LegalLayout from '../layouts/LegalLayout.astro';
import Rich from '../i18n/Rich.astro';
import { SITE } from '../config/site';
import { getCatalog } from '../i18n/catalog';
import { alternatesFor, localePath } from '../i18n/routes';
import type { EnabledLocale } from '../i18n/config';

interface Props {
  locale: EnabledLocale;
}
const { locale } = Astro.props;
const t = getCatalog(locale.code).accountDelete;
const vars = { email: SITE.email };
const links = { email: `mailto:${SITE.email}`, privacy: localePath(locale, '/privacy') };
---

<LegalLayout
  title={t.title}
  description={t.description}
  path={localePath(locale, '/account/delete')}
  heading={t.heading}
  intro={t.intro}
  locale={locale}
  alternates={alternatesFor('/account/delete')}
>
  <h2>{t.inApp.heading}</h2>
  <ol>
    {t.inApp.steps.map((s) => <li><Rich text={s} vars={vars} links={links} /></li>)}
  </ol>
  <p><Rich text={t.inApp.body} vars={vars} links={links} /></p>

  <h2>{t.kept.heading}</h2>
  <ul>
    {t.kept.items.map((s) => <li><Rich text={s} vars={vars} links={links} /></li>)}
  </ul>

  <h2>{t.byEmail.heading}</h2>
  <p><Rich text={t.byEmail.body} vars={vars} links={links} /></p>
</LegalLayout>
