---
import BaseLayout from '../layouts/BaseLayout.astro';
import SunriseSection from '../components/SunriseSection.astro';
import FeatureRow from '../components/FeatureRow.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import StoreButtons from '../components/StoreButtons.astro';
import StoreGallery from '../components/StoreGallery.astro';
import ReleaseNotice from '../components/ReleaseNotice.astro';
import Lark from '../components/Lark.astro';
import JsonLd from '../components/JsonLd.astro';
import Rich from '../i18n/Rich.astro';
import { interpolate } from '../i18n/rich';
import { SITE } from '../config/site';
import { getCatalog } from '../i18n/catalog';
import { alternatesFor, localePath } from '../i18n/routes';
import { isDefaultLocale, type EnabledLocale } from '../i18n/config';
import { blogIndexPath, getPublishedPosts, postPath, sourceSlugOf } from '../lib/blog';
import { publicMissions } from '../lib/product';
import { refreshCopy } from '../lib/refresh';
import { capture } from '../lib/store-assets';
interface Props { locale: EnabledLocale }
const { locale } = Astro.props;
const { home: t, shell } = getCatalog(locale.code);
const r = refreshCopy(locale.code);
const english = isDefaultLocale(locale);
const href = (path: string) => localePath(locale,path);
const feature = (slug: string) => href(`/features/${slug}`);
const vars = { ios:shell.requirements.ios,android:shell.requirements.android,annual:SITE.unlimited.annual,monthly:SITE.unlimited.monthly,trialDays:SITE.unlimited.trialDays };
const links = { terms: href('/terms') };
const FEATURED = ['iphone-alarm-didnt-go-off-causes','alarm-reliability-checklist-tonight','sleep-inertia-why-you-wake-up-groggy'];
const localPosts = await getPublishedPosts(locale.code);
const featured = FEATURED.map(slug => localPosts.find(p => sourceSlugOf(p) === slug)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const blogHref = await blogIndexPath(locale);
const missions = publicMissions().map(fact => ({ ...fact, ...t.mission.missions.find(m => m.id === fact.id)! }));
---
<BaseLayout title={t.title} description={shell.siteDescription} path={href('/')} locale={locale} alternates={alternatesFor('/')}>
  <JsonLd locale={locale} />
  <SunriseSection id="hero" class="!pt-12 sm:!pt-16">
    <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_1fr]">
      <div>
        <Lark pose="asleep" width={110} priority />
        <h1 class="mt-6 text-[clamp(2.5rem,7vw,4.25rem)] leading-[1.08]"><span class="mb-3 block text-base uppercase tracking-wider">{t.hero.kicker}</span>{t.hero.heading.pre}<span class="accent">{t.hero.heading.accent}</span> {t.hero.heading.post}</h1>
        <p class="lede mt-6">{r.hero}</p>
        <div class="mt-7"><StoreButtons pageId="home" placement="hero" localeCode={locale.code} press="full" /></div>
        <ReleaseNotice localeCode={locale.code}/>
      </div>
      <div class="flex justify-center"><PhoneFrame src={capture(locale.code,'home')} alt={r.screens.home} width={290} priority tilt={-2}/></div>
    </div>
  </SunriseSection>
  <SunriseSection id="loud" anchor="features">
    <FeatureRow screenshot={capture(locale.code,'tones')} alt={r.screens.tones} side="left">
      <h2>{r.loudTitle}</h2><p class="lede mt-5">{r.loud}</p><p class="dim mt-4">{r.volume}</p>
      <p class="mt-5"><a class="underline font-bold" href={feature('loud-alarm-clock')}>{r.features[0]![0]}</a></p>
    </FeatureRow>
  </SunriseSection>
  <SunriseSection id="scan">
    <FeatureRow screenshot={capture(locale.code,'scan')} alt={r.screens.scan} side="right">
      <h2>{r.scanTitle}</h2><p class="lede mt-5">{r.scan}</p>
      <ol class="mt-5 list-decimal space-y-2 ps-5">{(r.features[1]![2] as string[]).map(step => <li>{step}</li>)}</ol>
      <p class="mt-5"><a class="underline font-bold" href={feature('object-scan-alarm')}>{r.features[1]![0]}</a></p>
    </FeatureRow>
  </SunriseSection>
  <SunriseSection id="mission">
    <FeatureRow screenshot={capture(locale.code,'missions')} alt={r.screens.missions} side="left">
      <h2>{t.mission.heading.pre}<span class="accent">{t.mission.heading.accent}</span>{t.mission.heading.post}</h2><p class="lede mt-5">{r.missionsIntro}</p>
      <p class="dim mt-4">{r.repeat}</p>
    </FeatureRow>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-mission-directory>
      {missions.map(m => <li class="rounded-xl border border-white/15 bg-white/[0.06] p-5" data-mission-id={m.id}>
        <div class="flex flex-wrap items-baseline justify-between gap-2"><a class="font-bold underline underline-offset-4" href={feature(m.feature)}>{m.name}</a><span class="dim text-xs">{m.kind}</span></div><p class="dim mt-2">{m.body}</p>
      </li>)}
    </ul>
    <p class="mt-6"><a class="underline font-bold" href={href('/features')}>{r.hubTitle}</a></p>
  </SunriseSection>
  <SunriseSection id="gallery"><h2>{r.galleryTitle}</h2><StoreGallery localeCode={locale.code}/></SunriseSection>
  <SunriseSection id="smart">
    <FeatureRow screenshot={capture(locale.code,'rotation')} alt={r.screens.rotation} side="right">
      <h2>{t.smart.heading.pre}<span class="accent">{t.smart.heading.accent}</span>{t.smart.heading.post}</h2>
      <p class="lede mt-5">{t.smart.lede}</p><p class="dim mt-4">{t.smart.shifts}</p>
      <p class="mt-5 flex flex-wrap gap-4"><a class="underline" href={feature('calendar-alarm-clock')}>{r.features[6]![0]}</a><a class="underline" href={feature('shift-work-alarm-clock')}>{r.features[7]![0]}</a></p>
      <h3 class="mt-8 text-xl">{t.together.heading.pre}{t.together.heading.accent}{t.together.heading.post}</h3><p class="mt-3">{t.together.cards[0]!.body}</p>
    </FeatureRow>
  </SunriseSection>
  <SunriseSection id="sharp">
    <FeatureRow screenshot={capture(locale.code,'stats')} alt={r.screens.stats} side="left" scrim>
      <h2>{r.scoreTitle}</h2><p class="lede mt-5">{r.score}</p><p class="mt-4 dim">{r.warmup}</p>
      <p class="mt-5"><a class="underline font-bold" href={feature('sharpness-score')}>{r.features[8]![0]}</a></p>
    </FeatureRow>
  </SunriseSection>
  <SunriseSection id="platforms">
    <div class="max-w-3xl"><h2>Apple Watch &amp; Android</h2><p class="lede mt-5">{r.watch}</p><p class="mt-4">{r.android}</p><p class="mt-4">{shell.requirements.ios} · {shell.requirements.android}</p></div>
    <StoreGallery localeCode={locale.code} platform="watch"/>
  </SunriseSection>
  <SunriseSection id="reliable">
    <div class="grid gap-8 lg:grid-cols-2">
      <div><h2>{shell.footer.support}</h2><p class="mt-5">{t.reliable.lede}</p><p class="mt-4"><a class="underline font-bold" href={href('/support')}>{shell.footer.support}</a></p></div>
      <div><h2>{shell.footer.privacy}</h2><p class="mt-5">{r.backup}</p><p class="mt-4"><a class="underline font-bold" href={href('/privacy')}>{shell.footer.privacy}</a></p></div>
    </div>
  </SunriseSection>
  {/* ── 13. Pricing ─────────────────────────────────────────────────────── */}
  <SunriseSection id="pricing">
    <div class="max-w-2xl">
      <h2 class="text-[clamp(1.9rem,5vw,3rem)]">{t.pricing.heading.pre}<span class="accent">{t.pricing.heading.accent}</span>{t.pricing.heading.post}</h2>
      <p class="lede mt-5">{t.pricing.lede}</p>
    </div>

    {/* One plan, paid yearly or monthly. Each card's billed amount is its largest
        figure, and the free trial (the yearly plan's) never appears without the
        price that follows it (claims-matrix.md; App Review 3.1.2(c) holds the
        app's own paywall to the same rule). */}
    <div class="mt-10 grid max-w-3xl gap-5 sm:grid-cols-2">
      <div class="card relative mt-3 p-7 pt-9 ring-2 ring-[var(--color-coral)]" data-plan="yearly">
        <p class="trial-badge"><Rich text={t.pricing.unlimited.trialBadge} vars={vars} /></p>
        <h3 class="text-xl">{t.pricing.unlimited.yearly}</h3>
        <p class="mt-1 text-4xl font-extrabold">
          {SITE.unlimited.annual}<span class="text-base font-semibold dim">{t.pricing.unlimited.perYear}</span>
        </p>
        <p class="mt-3"><Rich text={t.pricing.unlimited.trial} vars={vars} strongClass="font-extrabold" /></p>
        <p class="mt-2 text-sm dim">{t.pricing.unlimited.trialCancel}</p>
      </div>
      <div class="card p-7 sm:mt-3 sm:pt-9" data-plan="monthly">
        <h3 class="text-xl">{t.pricing.unlimited.monthlyPlan}</h3>
        <p class="mt-1 text-4xl font-extrabold">
          {SITE.unlimited.monthly}<span class="text-base font-semibold dim">{t.pricing.unlimited.perMonth}</span>
        </p>
        <p class="mt-3 dim">{t.pricing.unlimited.monthly}</p>
      </div>
    </div>

    <div class="card mt-5 max-w-3xl p-7">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h3 class="text-xl">{t.pricing.unlimited.name}</h3>
          <p class="mt-1 dim">{t.pricing.unlimited.included}</p>
        </div>
        <div class="hidden shrink-0 sm:block"><Lark pose="celebrating" width={64} /></div>
      </div>
      <ul class="mt-5 grid gap-x-6 gap-y-2.5 text-[0.97rem] sm:grid-cols-2">
        {t.pricing.unlimited.features.map((f) => <li class="flex gap-2.5"><span aria-hidden="true" class="text-[var(--color-coral-ink)] font-bold">✓</span><span>{f}</span></li>)}
      </ul>
    </div>

    <p class="mt-6 max-w-2xl text-sm dim">
      <Rich text={t.pricing.billing} links={links} linkClass="underline underline-offset-2" />
    </p>
    {!english && <p class="mt-3 max-w-2xl text-sm dim">{t.pricing.usdNote}</p>}
  </SunriseSection>

  {/* ── 14. FAQ ─────────────────────────────────────────────────────────── */}
  <SunriseSection id="faq">
    <h2 class="text-[clamp(1.9rem,5vw,3rem)]">{t.faq.heading.pre}<span class="accent">{t.faq.heading.accent}</span>{t.faq.heading.post}</h2>
    <div class="mt-8 max-w-3xl divide-y divide-black/10">
      {
        t.faq.items.map((f) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold">
              {f.q}
              <span aria-hidden="true" class="shrink-0 text-2xl leading-none transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 leading-relaxed dim">{interpolate(f.a, vars)}</p>
          </details>
        ))
      }
    </div>
  </SunriseSection>

  {/* ── 15. From the blog ───────────────────────────────────────────────── */}
  {
    featured.length > 0 && (
      <SunriseSection id="from-blog">
        <h2 class="text-[clamp(1.9rem,5vw,3rem)]">{t.fromBlog.heading.pre}<span class="accent">{t.fromBlog.heading.accent}</span>{t.fromBlog.heading.post}</h2>
        <ul class="mt-8 grid gap-6 md:grid-cols-3">
          {featured.map((p) => (
            <li class="card p-6">
              <a href={postPath(p)} class="text-lg font-bold leading-snug underline-offset-2 hover:underline">{p.data.title}</a>
              <p class="mt-2 text-[0.95rem] dim">{p.data.description}</p>
            </li>
          ))}
        </ul>
        <p class="mt-6"><a href={blogHref} class="font-semibold underline underline-offset-2">{t.fromBlog.more}</a></p>
      </SunriseSection>
    )
  }

  <SunriseSection id="developer"><div class="max-w-2xl"><h2>{shell.footer.about}</h2><p class="lede mt-5">{r.developer}</p><p class="mt-4"><a class="underline" href={localePath(locale, "/contact")}>{shell.footer.contactForm}</a></p></div></SunriseSection>

  {/* ── 16. Final CTA ───────────────────────────────────────────────────── */}
  <SunriseSection id="cta" anchor="get">
    <div class="flex flex-col items-center text-center">
      <Lark pose="encouraging" width={170} />
      <h2 class="mt-6 text-[clamp(1.9rem,5vw,3rem)]">{t.cta.heading.pre}<span class="accent">{t.cta.heading.accent}</span>{t.cta.heading.post}</h2>
      <p class="lede mx-auto mt-5 text-center">{t.cta.lede}</p>
      <div class="mt-8 w-full max-w-2xl"><StoreButtons pageId="home" tone="light" align="center" placement="home-bottom" localeCode={locale.code} press="full" /></div>
    </div>
  </SunriseSection>
</BaseLayout>

<style>
  h2 { font-size:clamp(1.8rem,4.5vw,2.8rem); line-height:1.15; }
  details summary::-webkit-details-marker { display: none; }
  /* The yearly plan's trial, on the card's top edge: the download button's own
     coral and ink, 7.7:1. */
  .trial-badge {
    position: absolute;
    top: 0;
    inset-inline-start: 1.5rem;
    translate: 0 -50%;
    margin: 0;
    padding: 0.45rem 1.05rem;
    border-radius: 999px;
    background: var(--color-coral);
    color: var(--color-night-deep);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 0 6px 14px rgb(0 0 0 / 0.12);
  }
  @media (prefers-reduced-motion: reduce) {
    .group-open\:rotate-45 { transition: none; }
  }
</style>
