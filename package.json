{
  "name": "wakesharp-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "assets:prep": "node scripts/prep-assets.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "copy": "tsx scripts/check-copy.mjs",
    "verify": "npm run contrast && npm run posts && npm run build && npm run copy && npm run seo && npm run growth:test && npm run i18n:test && npm run tools:test && npm run product:test && npm run support:test",
    "growth:test": "tsx --test tests/growth/*.test.ts",
    "i18n:test": "tsx --test tests/i18n/*.test.ts",
    "posts": "tsx scripts/check-blog-post.mjs --all",
    "seo": "tsx scripts/check-seo.mjs --strict",
    "product:test": "tsx --test tests/product/*.test.ts",
    "assets:store": "node scripts/import-store.mjs",
    "tools:test": "tsx --test tests/tools/*.test.ts",
    "support:test": "tsx --test tests/support/*.test.ts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/nunito": "^5.2.5",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.2.8",
    "pg": "^8.23.1",
    "posthog-js": "^1.434.14",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "^1.2.0",
    "@img/sharp-linux-x64": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0"
  }
}
