{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/privacy-policy", "destination": "/privacy", "permanent": true },
    { "source": "/privacypolicy", "destination": "/privacy", "permanent": true },
    { "source": "/legal/privacy", "destination": "/privacy", "permanent": true },
    { "source": "/terms-of-service", "destination": "/terms", "permanent": true },
    { "source": "/legal/terms", "destination": "/terms", "permanent": true },
    { "source": "/tos", "destination": "/terms", "permanent": true },
    { "source": "/eula", "destination": "/terms", "permanent": true },
    { "source": "/help", "destination": "/support", "permanent": true }
  ],
  "functions": {
    "api/contact.ts": { "maxDuration": 10 },
    "api/referrals/*.ts": { "maxDuration": 10 },
    "api/internal/referrals/*.ts": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/og.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "rewrites": [
    { "source": "/r/:code", "destination": "/api/referrals/landing" },
    { "source": "/c/:payload", "destination": "/c" },
    { "source": "/p/:payload", "destination": "/p" },
    { "source": "/:lang(es|ru|tr)/c/:payload", "destination": "/:lang/c" },
    { "source": "/:lang(es|ru|tr)/p/:payload", "destination": "/:lang/p" }
  ]
}
